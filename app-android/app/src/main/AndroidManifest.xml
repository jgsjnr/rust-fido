<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE runtime set (API 31+, minSdk 31 / target 34).
         SCAN with neverForLocation: 0xFFFD service-UUID filter needs no
         location and the app never derives physical location from BLE.
         ACCESS_FINE/COARSE_LOCATION is therefore INTENTIONALLY ABSENT --
         requesting it would imply location use the app does not perform
         (scan sem location, CDM sem location). Do NOT add it.
         CONNECT covers connectGatt/createBond/bondedDevices/GATT I/O.
         NOT requested on purpose: BLUETOOTH_ADVERTISE (central only, never
         peripheral), NEARBY_WIFI_DEVICES (no WifiManager scan -- plain
         HttpURLConnection to the AP IP), POST_NOTIFICATIONS (no
         notifications / no foreground service). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- WiFi AP transport: POST /ctap, POST /config/wifi, GET /oath/code.
         Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE runtime set (API 31+, minSdk 31 / target 34).
         Decisao de permissoes (revisada, fail-closed / menor privilegio):
         - BLUETOOTH_SCAN (neverForLocation) + BLUETOOTH_CONNECT: pedidas.
           Filtro 0xFFFD nao precisa de localizacao e o app nunca deriva
           posicao fisica do BLE; CONNECT cobre connectGatt/createBond/
           bondedDevices/GATT I/O.
         - ACCESS_FINE/COARSE_LOCATION: AUSENTE de proposito. Com SCAN +
           neverForLocation (API 31+) o scan nao usa localizacao; pedir
           LOCATION implicaria um uso que o app nao faz.
         - BLUETOOTH_ADVERTISE: AUSENTE de proposito. Central only (scan +
           GATT cliente); o app nunca anuncia como periferico.
         - POST_NOTIFICATIONS: pedida para sinais de aprovacao. Negada = sem sinal; aprovacoes seguem no app.
         Ramificacoes de versao vivem no codigo (BlePermissions +
         AegisBleClient): minSdk 31 => so existem ramos S+ (33+ p/ flags de
         receiver e overloads GATT); nenhum ramo legado pre-31. Nao adicionar
         permissoes sem uso real no transporte. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Approval signals only (local, signal-only, no push): runtime prompt on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Biometric auth (BindingKey + BiometricGate): normal permission,
         granted at install, no runtime prompt. Required by lint
         (MissingPermission) for canAuthenticate/authenticate. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- WiFi AP transport: POST /ctap, POST /config/wifi, GET /oath/code.
         Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- USB host (CTAPHID 64B, VID 0x303A / PID 0xAE61): unica adicao.
         Sem permissao nova: UsbManager.requestPermission e runtime via
         dialogo do sistema. neverForLocation mantido; sem LOCATION. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:name=".AegisApplication"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_FILTER"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Vault autofill in other apps (Android Autofill Framework).
             Fail-closed: the service answers null unless the Settings
             master switch is on AND a Secure Guard session is unlocked.
             Binding is granted by the OS picker only. -->
        <service
            android:name=".autofill.AegisAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.service.autofill"
                android:resource="@xml/autofillservice" />
        </service>

        <!-- Approval-signal actions (local only, no push). Non-exported:
             only this app's own notifications can trigger it. Both actions
             route through the same fail-closed gate; a bare tap can never
             approve (receiver sees no foreground, no biometry). -->
        <receiver
            android:name=".approval.ApprovalActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.aegiskey.app.approval.APPROVE" />
                <action android:name="dev.aegiskey.app.approval.DENY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

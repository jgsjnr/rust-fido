<?xml version="1.0" encoding="utf-8"?>
<!-- A-01: cleartext is denied by default (HTTPS-everywhere).
     Cleartext is permitted ONLY for the link-local hosts the app truly
     needs: the SoftAP gateway (192.168.4.1, WPA2 + AES-GCM envelopes),
     the emulator host loopback (10.0.2.2, dev/Renode bridge only), and
     device loopback (127.0.0.1 / localhost, host bridge client).
     Anything else fails closed at the platform layer. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

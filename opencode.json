{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@xberg-io/opencode-crawlberg",
    "@xberg-io/opencode-html-to-markdown",
    "kibi-opencode",
    "@opencode-ai/plugin",
    "@xberg-io/opencode-liter-llm",
    "opencode-host-notify-bridge",
    "@xberg-io/opencode-tree-sitter-language-pack",
    "@xberg-io/opencode-xberg",
    "@dv.nghiem/flowdeck",
    "opencode-goal-plugin@0.11.0"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": "ask"
  }
}
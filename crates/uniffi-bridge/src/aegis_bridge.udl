// FROZEN — UniFFI runtime removed (refactor(ffi): drop UniFFI runtime for
// manual JNI, zero MPL). This file is now a READ-ONLY contract reference:
// `build.rs` scaffolding is gone, nothing reads this file at build time.
// The 22 functions below map 1:1 to the `aegis_*` manual C ABI in
// `src/lib.rs` (see reports/refactoring/UNIFFI_REMOVAL_PLAN.md §4).
// Original header preserved below for provenance.
// AegisKey UniFFI contract - mirrors docs/ble-protocol.md (frozen).
// Rust implements these in src/lib.rs; Kotlin bindings are generated with:
//   cargo run -p uniffi-bindgen -- generate src/aegis_bridge.udl --language kotlin
// Secrets never cross this interface: only envelopes (AEGN), TOTP codes,
// account labels and wallet addresses (public-key encodings). Keys are
// caller-provided transient buffers, zeroized in Rust.

namespace aegis_bridge {
    BleInfo ble_constants();
    [Throws=BridgeError] sequence<sequence<u8>> ble_split_fragments(u8 opcode, sequence<u8> payload);
    [Throws=BridgeError] u32 envelope_validate(sequence<u8> envelope);
    [Throws=BridgeError] sequence<u8> envelope_seal(sequence<u8> key, sequence<u8> plaintext, sequence<u8> aad, sequence<u8> nonce);
    [Throws=BridgeError] sequence<u8> envelope_open(sequence<u8> key, sequence<u8> envelope, sequence<u8> aad);
    [Throws=BridgeError] string cose_key_info(sequence<u8> cbor);
    [Throws=BridgeError] OathCode oath_parse_response(string json);
    boolean oath_code_valid(string code);
    u32 oath_remaining_seconds(u64 unix_seconds);
    boolean wifi_password_valid(string password);
    string? oath_account_from_path(string path);
    [Throws=BridgeError] sequence<u8> app_lock_derive(sequence<u8> password, sequence<u8> salt);
    [Throws=BridgeError] string wallet_address(string network, string pubkey_hex);
    string totp_format_display(string code);
    [Throws=BridgeError] OtpAuthParsed otpauth_extract_label_and_secret(string input);

    // --- Secure Guard ---
    [Throws=BridgeError] SecureGuardStatusDto secure_guard_parse_status(sequence<u8> payload);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_provision(sequence<u8> pin, sequence<u8> recovery_code, boolean wipe_on_5_failures, boolean test_mode);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_unlock(sequence<u8> pin);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_change_pin(sequence<u8> current_pin, sequence<u8> new_pin);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_recover(sequence<u8> recovery_code, sequence<u8> new_pin);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_lock();
    [Throws=BridgeError] sequence<u8> secure_guard_encode_config(SecureGuardPolicyDto policy);
    [Throws=BridgeError] sequence<u8> secure_guard_encode_wipe(u8 scope, string confirm_token);
};

dictionary BleInfo {
    u16 service_uuid;
    u16 control_uuid;
    u16 status_uuid;
    u16 len_uuid;
    u16 revision_uuid;
    u8 gatt_revision;
    u8 op_ping;
    u8 op_msg;
    u8 op_cancel;
    u32 max_fragment_bytes;
    u32 control_point_length;
};

dictionary OathCode {
    string account;
    string code;
    u32 remaining_seconds;
};

dictionary OtpAuthParsed {
    string issuer;
    string account_name;
    string secret_base32;
    u8 digits;
    u32 period;
};

dictionary SecureGuardPolicyDto {
    boolean wipe_on_5_failures;
    u64 session_duration_ms;
    u64 inactivity_timeout_ms;
    boolean protect_keys_and_aegn;
    boolean protect_oath;
    boolean test_mode_non_destructive_wipe;
};

dictionary SecureGuardStatusDto {
    u8 state;
    string state_name;
    boolean is_provisioned;
    boolean is_unlocked;
    u8 failed_attempts;
    u8 remaining_attempts;
    u8 max_attempts;
    u64 rate_limit_remaining_ms;
    u64 session_remaining_ms;
    SecureGuardPolicyDto policy;
    boolean last_wipe_simulated;
    u64 audit_count;
};

[Error]
enum BridgeError {
    "InvalidOpcode",
    "Overflow",
    "InvalidFragment",
    "InvalidEnvelope",
    "InvalidCose",
    "InvalidOath",
    "CryptoError",
    "InvalidAddress",
    "SecureGuardError",
};
